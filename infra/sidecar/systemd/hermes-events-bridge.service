[Unit]
Description=NeureCore Hermes Signed Event Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes-sidecar
Group=hermes-sidecar
WorkingDirectory=/opt/neurecore/infra/hermes-events-bridge
EnvironmentFile=/opt/neurecore/backend/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=HERMES_EVENTS_BRIDGE_DB=/var/lib/neurecore/hermes/events.db
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/neurecore/hermes
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
MemoryMax=256M
CPUQuota=100%
TasksMax=32
ExecStart=/opt/neurecore/infra/venv/bin/uvicorn hermes_events_bridge.main:app --host 127.0.0.1 --port 8082 --workers 1 --log-level info
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
