# ═══════════════════════════════════════════════════════════════════════════
# NeureCore Admin Portal — Local Production Environment
# ═══════════════════════════════════════════════════════════════════════════
# Backend runs on localhost:3000 (with Contabo databases via SSH tunnel)
# Frontend runs on localhost:3001 (Vite dev server)

# ─── API Configuration ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# ─── App URLs ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://hq.neurecore.com
NEXT_PUBLIC_ADMIN_URL=https://cc.neurecore.com

# ─── Auth ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AUTH_DOMAIN=neurecore.us.auth0.com
NEXT_PUBLIC_AUTH_CLIENT_ID=your_auth0_client_id
NEXT_PUBLIC_AUTH_AUDIENCE=https://api.neurecore.com
NEXT_PUBLIC_AUTH_REDIRECT_URI=http://localhost:3001/callback

# ─── Environment ─────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_NODE_ENV=production
