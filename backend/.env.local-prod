# ═══════════════════════════════════════════════════════════════════════════
# NeureCore Backend — Local Production (Development Machine)
# ═══════════════════════════════════════════════════════════════════════════
# This runs the backend locally but connects to Contabo databases.
# SSH tunnel must be running: ./scripts/ssh-tunnel.sh start
# 
# Usage:
#   ./scripts/ssh-tunnel.sh start    # Start SSH tunnel
#   cp .env.local-prod .env          # Copy to .env
#   npm run start:dev                # Run backend

# ─── Application ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
BACKEND_PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# ─── Frontend URLs (CORS whitelist) ───────────────────────────────────────
TENANT_FRONTEND_URL=https://hq.neurecore.com
ADMIN_FRONTEND_URL=https://cc.neurecore.com
ADDITIONAL_CORS_ORIGINS=

# ─── Database (PostgreSQL - Contabo via SSH Tunnel) ────────────────────────
# SSH Tunnel: 127.0.0.1:15433 → Contabo:5432
# Start tunnel: ./scripts/ssh-tunnel.sh start
DATABASE_URL=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@127.0.0.1:15433/neurecore_prod?sslmode=prefer
DATABASE_URL_UNPOOLED=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@127.0.0.1:15433/neurecore_prod?sslmode=prefer
POSTGRES_URL=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@127.0.0.1:15433/neurecore_prod?sslmode=prefer
POSTGRES_URL_NON_POOLING=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@127.0.0.1:15433/neurecore_prod?sslmode=prefer
POSTGRES_USER=neurecore_app
POSTGRES_HOST=127.0.0.1
POSTGRES_PASSWORD=NeureCoreApp2026!SecureDBPass
POSTGRES_DATABASE=neurecore_prod
POSTGRES_PORT=15433
POSTGRES_URL_NO_SSL=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@127.0.0.1:15433/neurecore_prod
POSTGRES_PRISMA_URL=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@127.0.0.1:15433/neurecore_prod?sslmode=prefer

# Database Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT=30

# ─── Cache (Redis - Contabo via SSH Tunnel) ────────────────────────────────
# SSH Tunnel: 127.0.0.1:16380 → Contabo:6379
REDIS_URL=redis://:kPzbcTiOQBWwTs6dr4xinAWfXhbUv3AFjRdkjhvxQ=@127.0.0.1:16380/0
REDIS_PASSWORD=kPzbcTiOQBWwTs6dr4xinAWfXhbUv3AFjRdkjhvxQ=
REDIS_HOST=127.0.0.1
REDIS_PORT=16380

# Cache TTL Settings
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SHORT=60
CACHE_TTL_LONG=86400

# ─── JWT Authentication ────────────────────────────────────────────────────
JWT_SECRET=NeureCore2026ProdSecretKey-Minimum32CharsRequired!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Auth Configuration ────────────────────────────────────────────────────
AUTH0_DOMAIN=neurecore.us.auth0.com
AUTH0_AUDIENCE=https://api.neurecore.com
AUTH0_ISSUER=https://neurecore.us.auth0.com/

# ─── Rate Limiting ────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=30
THROTTLE_AUTH_LIMIT=5
THROTTLE_API_LIMIT=60
THROTTLE_UPLOAD_LIMIT=3

# ─── Security ──────────────────────────────────────────────────────────────
SESSION_COOKIE_SECURE=false
CSRF_ENABLED=false
HELMET_ENABLED=true
