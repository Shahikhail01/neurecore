# ═══════════════════════════════════════════════════════════════════════════
# NeureCore Backend — Local Dev → Contabo Databases
# ═══════════════════════════════════════════════════════════════════════════
# Use this for local development with Contabo as the permanent database.
#
# IMPORTANT: SSH tunnel must be running before starting the backend.
# Start tunnel:  ./scripts/ssh-tunnel.sh start
# Start backend: pnpm run start:local-contabo
#
# SSH tunnels: localhost:15433 → Contabo:5432 (PostgreSQL)
#              localhost:16380 → Contabo:6379  (Redis)
# ═══════════════════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────────────────
# NODE_ENV=development is REQUIRED — lets CORS allow localhost frontends
NODE_ENV=development
PORT=3000
BACKEND_PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ─── Frontend URLs (CORS whitelist) ────────────────────────────────────────
TENANT_FRONTEND_URL=http://localhost:3001
ADMIN_FRONTEND_URL=http://localhost:3002
ADDITIONAL_CORS_ORIGINS=

# ─── Database (PostgreSQL — Contabo via SSH Tunnel) ────────────────────────
# SSH Tunnel maps: localhost:15433 → remote (Contabo):5432
# Start with: ./scripts/ssh-tunnel.sh start
DATABASE_URL=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@127.0.0.1:15433/neurecore_prod?sslmode=prefer
DATABASE_URL_UNPOOLED=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@127.0.0.1:15433/neurecore_prod?sslmode=prefer
POSTGRES_URL=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@127.0.0.1:15433/neurecore_prod?sslmode=prefer
POSTGRES_URL_NON_POOLING=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@127.0.0.1:15433/neurecore_prod?sslmode=prefer
POSTGRES_USER=neurecore_app
POSTGRES_HOST=127.0.0.1
POSTGRES_PASSWORD=NeureCoreApp2026!SecureDBPass
POSTGRES_DATABASE=neurecore_prod
POSTGRES_PORT=15433
POSTGRES_URL_NO_SSL=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@127.0.0.1:15433/neurecore_prod
POSTGRES_PRISMA_URL=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@127.0.0.1:15433/neurecore_prod?sslmode=prefer

# Database Pool Settings
DATABASE_POOL_SIZE=5
DATABASE_CONNECTION_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT=30

# ─── Cache (Redis — Contabo via SSH Tunnel) ────────────────────────────────
# SSH Tunnel maps: localhost:16380 → remote (Contabo):6379
REDIS_URL=redis://:kPzbcTiOQBWwTs6dr4xinAWfXhbUv3AFjRdkjhvxQ=@127.0.0.1:16380/0
REDIS_HOST=127.0.0.1
REDIS_PORT=16380
REDIS_PASSWORD=kPzbcTiOQBWwTs6dr4xinAWfXhbUv3AFjRdkjhvxQ=
UPSTASH_REDIS_URL=redis://:kPzbcTiOQBWwTs6dr4xinAWfXhbUv3AFjRdkjhvxQ=@127.0.0.1:16380/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cache TTL Settings
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SHORT=60
CACHE_TTL_LONG=86400

# ─── JWT Authentication ────────────────────────────────────────────────────
# Using same secret as production so existing sessions/tokens remain valid
JWT_SECRET=NeureCore2026ProdSecretKey-Minimum32CharsRequired!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ALGORITHM=HS256
JWT_ISSUER=neurecore
JWT_AUDIENCE=neurecore-api

# ─── Rate Limiting ─────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
THROTTLE_AUTH_LIMIT=10
THROTTLE_API_LIMIT=100
THROTTLE_UPLOAD_LIMIT=5

# ─── CORS Configuration ────────────────────────────────────────────────────
CORS_ENABLED=true
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_HEADERS=Content-Type,Authorization

# ─── Security ──────────────────────────────────────────────────────────────
SESSION_SECRET=NeureCore2026ProdSecretKey-Minimum32CharsRequired!
SESSION_COOKIE_NAME=neurecore.sid
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=86400000
CSRF_ENABLED=true
HELMET_ENABLED=true
API_KEY_HEADER=x-api-key
RATE_LIMIT_BY_IP=true

# ─── Features (disable heavy services in dev unless needed) ────────────────
OTEL_ENABLED=false
MODEL_RUNNER_ENABLED=false
MODEL_RUNNER_URL=http://localhost:8080
ENABLE_AI_GATEWAY=false
ENABLE_AGENT_EXECUTION=false
ENABLE_WORKFLOW_AUTOMATION=false
