    "certify:toolset": "ts-node scripts/certify-domain-toolset.ts",
    "certify:sim04": "node ../simulations/SIM-04-Accounting-Project-Full-Flow/certify-sim04.mjs",
    "inventory:templates": "ts-node scripts/inventory-templates.ts",
    "phase4:activate-accounting-domain": "ts-node scripts/phase4-activate-accounting-domain.ts",
