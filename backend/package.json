    "certify:phase7:report": "ts-node src/harness/phase7/run-phase7-certification.ts",
    "certify:phase8": "jest --config jest.config.js --runInBand src/harness/phase8/",
    "certify:phase8:report": "ts-node src/harness/phase8/run-phase8-certification.ts",
    "certify:phase8:all": "jest --config jest.config.js --runInBand src/harness/phase8/ && ts-node src/harness/phase8/run-phase8-certification.ts",
    "certify:phase9:verdict": "jest --config jest.config.js --runInBand src/harness/phase9/",
    "certify:phase9:release-gate": "ts-node src/harness/phase9/run-phase9-certification.ts",
    "certify:phase9:all": "jest --config jest.config.js --runInBand src/harness/phase9/ && ts-node src/harness/phase9/run-phase9-certification.ts",
    "certify:phase9:staging": "jest --config jest.config.js --runInBand src/harness/phase9/staging-evidence.spec.ts",
    "certify:phase9:staging:all": "jest --config jest.config.js --runInBand src/harness/phase9/staging-evidence.spec.ts && PHASE9_STAGING_MODE=1 ts-node src/harness/phase9/run-phase9-certification.ts",
    "certify:phase10": "ts-node scripts/run-phase10-certification.ts",
    "certify:phase10:spec": "jest --config jest.config.js --runInBand src/harness/phase10/",
    "certify:phase10:all": "jest --config jest.config.js --runInBand src/harness/phase10/ && ts-node scripts/run-phase10-certification.ts",
    "certify:phase11": "ts-node scripts/run-phase11-certification.ts",
    "certify:phase11:spec": "jest --config jest.config.js --runInBand src/harness/phase11/",
    "certify:phase11:all": "jest --config jest.config.js --runInBand src/harness/phase11/ && ts-node scripts/run-phase11-certification.ts",
    "parity:matrix:build": "ts-node scripts/build-matrix-from-v2.ts",
    "parity:matrix:check": "ts-node scripts/build-matrix-from-v2.ts --check",
    "test:matrix": "ts-node scripts/test-matrix.ts",
    "routes:scan": "ts-node scripts/detect-route-duplication.ts",
    "routes:scan:strict": "ts-node scripts/detect-route-duplication.ts --fail",
    "tenancy:scan": "ts-node scripts/detect-wildcard-tenant-bypass.ts",
    "tenancy:scan:strict": "ts-node scripts/detect-wildcard-tenant-bypass.ts --fail",
    "a11y:scan": "ts-node scripts/run-a11y-audit.ts",
    "a11y:scan:strict": "ts-node scripts/run-a11y-audit.ts --fail",
    "certify:phase29": "jest --config jest.config.js --runInBand src/test/certification/g29-accessibility-localization.spec.ts",
    "certify:phase30": "jest --config jest.config.js --runInBand src/test/certification/g30-cost-ceiling-resilience.spec.ts",
    "certify:solid": "jest --config jest.config.js --runInBand src/test/certification/parity-completion/",
    "certify:phase29:all": "pnpm a11y:scan && pnpm certify:phase29 && pnpm certify:solid",
    "certify:phase30:all": "pnpm certify:phase30 && pnpm certify:solid"
  },
