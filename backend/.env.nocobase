# NocoDB Integration - Environment Variables

# NocoDB Configuration
NOCO_BASE_URL=http://localhost:8080
NOCO_API_TOKEN=your_api_token_here

# Database (Neon PostgreSQL for NocoDB)
DATABASE_URL=postgresql://user:password@neon_host/noco_database

# Event Bus (in-memory by default)
EVENT_BUS_TYPE=memory

# Logger
LOG_LEVEL=debug

# API Server
API_PORT=3000
NODE_ENV=development
