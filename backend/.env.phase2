# JWT Secret key (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here-32-characters-minimum

# JWT Refresh secret (different from access secret for security)
JWT_REFRESH_SECRET=your-refresh-secret-key-here-minimum-32-characters

# Token expiry times
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Database (NocoDB)
NOCO_BASE_URL=http://localhost:8080
NOCO_API_TOKEN=your-nocobase-api-token

# Application
APP_ENV=development
APP_PORT=3000
LOG_LEVEL=debug

# CORS (allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Rate limiting (requests per minute)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Session timeout (milliseconds)
SESSION_TIMEOUT=900000

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
