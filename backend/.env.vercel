# ═══════════════════════════════════════════════════════════════════════════
# NeureCore Backend — Vercel Production Environment
# ═══════════════════════════════════════════════════════════════════════════
# IMPORTANT: This config is for Vercel deployment.
# Set these in Vercel Dashboard → Environment Variables
# NEVER commit this file to version control.

# ─── Application ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
BACKEND_PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# ─── Frontend URLs (CORS whitelist) ───────────────────────────────────────
TENANT_FRONTEND_URL=https://hq.neurecore.com
ADMIN_FRONTEND_URL=https://cc.neurecore.com
ADDITIONAL_CORS_ORIGINS=

# ─── Database (PostgreSQL - Contabo Direct Connection) ─────────────────────
# Vercel connects directly to Contabo PostgreSQL
# pg_hba.conf allows 76.76.0.0/16 (Vercel IPs)
# SSL required for all connections
DATABASE_URL=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@109.123.248.253:5432/neurecore_prod?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@109.123.248.253:5432/neurecore_prod?sslmode=require
POSTGRES_URL=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@109.123.248.253:5432/neurecore_prod?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@109.123.248.253:5432/neurecore_prod?sslmode=require
POSTGRES_USER=neurecore_app
POSTGRES_HOST=109.123.248.253
POSTGRES_PASSWORD=NeureCoreApp2026!SecureDBPass
POSTGRES_DATABASE=neurecore_prod
POSTGRES_PORT=5432
POSTGRES_URL_NO_SSL=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@109.123.248.253:5432/neurecore_prod
POSTGRES_PRISMA_URL=postgresql://neurecore_app:NeureCoreApp2026!SecureDBPass@109.123.248.253:5432/neurecore_prod?sslmode=require

# Database Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT=30

# ─── Cache (Redis - Contabo with TLS) ─────────────────────────────────────
# Vercel connects directly to Contabo Redis
# Redis binds to 109.123.248.253 with password auth
REDIS_URL=redis://:kPzbcTiOQBWwTs6dr4xinAWfXhbUv3AFjRdkjhvxQ=@109.123.248.253:6379/0
REDIS_PASSWORD=kPzbcTiOQBWwTs6dr4xinAWfXhbUv3AFjRdkjhvxQ=
REDIS_HOST=109.123.248.253
REDIS_PORT=6379

# Cache TTL Settings
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SHORT=60
CACHE_TTL_LONG=86400

# ─── JWT Authentication ────────────────────────────────────────────────────
JWT_SECRET=NeureCore2026ProdSecretKey-Minimum32CharsRequired!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Auth Configuration ────────────────────────────────────────────────────
AUTH0_DOMAIN=neurecore.us.auth0.com
AUTH0_AUDIENCE=https://api.neurecore.com
AUTH0_ISSUER=https://neurecore.us.auth0.com/

# ─── Vercel Deployment ─────────────────────────────────────────────────────
# VERCEL_GIT_COMMIT_REF=main
# VERCEL_REGION=sgp1
