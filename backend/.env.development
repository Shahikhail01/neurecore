# ═══════════════════════════════════════════════════════════════════════════
# NeureCore Backend — Local Development Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# This file is for local development with Docker containers.
# Copy this to .env.local for local development.

# ─── Application ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
BACKEND_PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ─── Frontend URLs (CORS whitelist) ───────────────────────────────────────
TENANT_FRONTEND_URL=http://localhost:3001
ADMIN_FRONTEND_URL=http://localhost:3002
ADDITIONAL_CORS_ORIGINS=

# ─── Database (PostgreSQL - Local Docker) ─────────────────────────────────
DATABASE_URL=postgresql://neurecore:password@localhost:5432/neurecore_dev?schema=public
DATABASE_URL_UNPOOLED=postgresql://neurecore:password@localhost:5432/neurecore_dev?schema=public
POSTGRES_URL=postgresql://neurecore:password@localhost:5432/neurecore_dev?schema=public
POSTGRES_URL_NON_POOLING=postgresql://neurecore:password@localhost:5432/neurecore_dev?schema=public
POSTGRES_USER=neurecore
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=neurecore_dev
POSTGRES_URL_NO_SSL=postgresql://neurecore:password@localhost:5432/neurecore_dev?schema=public
POSTGRES_PRISMA_URL=postgresql://neurecore:password@localhost:5432/neurecore_dev?schema=public

# Database Pool Settings
DATABASE_POOL_SIZE=5
DATABASE_CONNECTION_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT=30

# ─── Cache (Redis - Local Docker) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cache TTL Settings
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SHORT=60
CACHE_TTL_LONG=86400

# ─── JWT Authentication ────────────────────────────────────────────────────
JWT_SECRET=dev-super-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ALGORITHM=HS256
JWT_ISSUER=neurecore
JWT_AUDIENCE=neurecore-api

# ─── Rate Limiting ─────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
THROTTLE_AUTH_LIMIT=10
THROTTLE_API_LIMIT=100
THROTTLE_UPLOAD_LIMIT=5

# ─── CORS Configuration ─────────────────────────────────────────────────────
CORS_ENABLED=true
CORS_ORIGINS=
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_HEADERS=Content-Type,Authorization

# ─── Security ────────────────────────────────────────────────────────────────
SESSION_SECRET=dev-session-secret-change-in-production
SESSION_COOKIE_NAME=neurecore.sid
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE=86400000
CSRF_ENABLED=true
HELMET_ENABLED=true
API_KEY_HEADER=x-api-key
RATE_LIMIT_BY_IP=true

# ─── AI / LLM API Keys (Optional) ──────────────────────────────────────────
# Add your API keys here for AI features
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── OpenTelemetry (Optional - disable for local dev) ─────────────────────
OTEL_ENABLED=false

# ─── Model Runner (Optional - disable for local dev) ─────────────────────
MODEL_RUNNER_ENABLED=false
MODEL_RUNNER_URL=http://localhost:8080

# ─── Feature Flags ─────────────────────────────────────────────────────────
ENABLE_AI_GATEWAY=false
ENABLE_AGENT_EXECUTION=false
ENABLE_WORKFLOW_AUTOMATION=false
