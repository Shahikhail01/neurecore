// Prisma Schema - NeureCore Gold
// Phase 1+2+3: Foundation + Agent Runtime + Governance/Observability Tables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SECURITY_OFFICER
  SUPPORT
  OWNER
  ADMIN
  USER
  AUDITOR
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

// DEPRECATED: TenantPlan enum - use Tier model instead
// Kept for migration compatibility only
enum TenantPlan {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

// ─── Phase 2 Enums ────────────────────────────────────────────────────────

enum AgentStatus {
  IDLE
  RUNNING
  PAUSED
  ERROR
  TERMINATED
}

enum AgentType {
  CORE
  FUNCTIONAL
  EXECUTIVE
  META
}

enum TaskStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  ARCHIVED
}

enum MemoryType {
  SHORT_TERM
  LONG_TERM
  EPISODIC
}

enum ToolCategory {
  COMMUNICATION
  DATABASE
  API
  FILE
  CALCULATION
  SEARCH
  CUSTOM
}

// ─── Phase 3 Enums ────────────────────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ApprovalPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  APPROVAL_REQUEST
  AGENT_ALERT
  BILLING_ALERT
  SECURITY_ALERT
}

enum GovernanceActionType {
  BLOCK
  REQUIRE_APPROVAL
  RATE_LIMIT
  ALERT
  LOG_ONLY
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum MetricType {
  COUNTER
  GAUGE
  HISTOGRAM
}

// ─── Phase 4.3 / 4.4 Enums ───────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseCategory {
  AGENT_EXECUTION
  TOOL_USAGE
  API_CALL
  MODEL_INFERENCE
  CONNECTOR_SYNC
  CUSTOM
}

enum BillingEventType {
  INVOICE_CREATED
  INVOICE_ISSUED
  INVOICE_PAID
  INVOICE_OVERDUE
  INVOICE_CANCELLED
  EXPENSE_RECORDED
  BUDGET_EXCEEDED
  THRESHOLD_WARNING
  TAX_APPLIED
}

// ─── Phase Implementation (2/3/4) Enums ─────────────────────────────────────

enum DeploymentMode {
  PRODUCTION
  STAGING
}

enum EvaluationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum KnowledgeSourceType {
  MANUAL
  GOOGLE_DRIVE
  NOTION
  CONFLUENCE
  GITHUB
  SLACK
}

enum SsoProvider {
  SAML
  OIDC
}

// ─── Workspace Provisioning Enums ─────────────────────────────────────────

enum ProvisioningProvider {
  GOOGLE_WORKSPACE
  MICROSOFT_365
}

enum ProvisioningConfigStatus {
  PENDING_CONNECT
  CONNECTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ProvisioningJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

enum EmailPattern {
  FIRST_DOT_LAST
  FIRSTLAST
  F_DOT_LAST
}

enum FolderStructure {
  BY_DEPARTMENT
  FLAT
}

// ─── Tier (Phase 6: Unified Tier-Agent Architecture) ───────────────────────

model Tier {
  id            String   @id @default(uuid())
  name          String   // "Free", "Starter", "Pro", "Enterprise"
  slug          String   @unique // "free", "starter", "pro", "enterprise"
  description   String?
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)

  // Pricing
  monthlyPrice  Decimal  @db.Decimal(10, 2) @default(0)
  yearlyPrice   Decimal  @db.Decimal(10, 2) @default(0)
  currency      String   @default("USD")

  // Limits
  maxUsers      Int      @default(2)
  maxAgents     Int      @default(3)
  maxStorageGB  Int      @default(1)
  maxApiCalls   Int      @default(1000)
  maxConversationMessages Int @default(500)
  maxFileSizeMB Int      @default(10)

  // Feature flags
  allowCustomBranding  Boolean @default(false)
  allowApiAccess       Boolean @default(false)
  allowSso             Boolean @default(false)
  allowAuditExport     Boolean @default(false)

  // Relations
  tierAgentPools TierAgentPool[]
  tenants       Tenant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tiers")
}

// ─── TierAgentPool (Phase 6: Agent allocation per tier) ─────────────────────

model TierAgentPool {
  id         String   @id @default(uuid())
  tierId     String
  tier       Tier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
  templateId String
  template   AgentTemplate @relation(fields: [templateId], references: [id])

  // Slot position in tier (1 = first available, 2 = second, etc.)
  slot       Int      @default(1)

  // Whether tenant MUST have this agent (true) or optional (false)
  isRequired Boolean  @default(false)

  // Tier-specific default config overrides
  defaultBudgetPerDay Decimal? @db.Decimal(10, 4)
  defaultModel       String?
  isDefaultSelected   Boolean  @default(true) // pre-selected on tenant creation

  createdAt DateTime @default(now())

  // Phase 6: Agents created from this pool entry
  agents Agent[]

  @@unique([tierId, templateId])
  @@index([tierId])
  @@map("tier_agent_pools")
}

// ─── Tenant ────────────────────────────────────────────────────────────────

model Tenant {
  id         String       @id @default(uuid())
  name       String
  slug       String       @unique
  status     TenantStatus @default(ACTIVE)
  logoUrl    String?
  website    String?
  industry   String?
  settings   Json         @default("{}")
  metadata   Json         @default("{}")

  // Tier relation (Phase 6: replaces plan + agentLimit)
  tierId String
  tier   Tier   @relation(fields: [tierId], references: [id])

  // DEPRECATED: plan and agentLimit removed - use tier instead
  // plan       TenantPlan   (use tier.slug)
  // agentLimit Int          (use tier.maxAgents)

  // Relations
  users            User[]
  auditLogs        AuditLog[]
  sessions         Session[]
  agents           Agent[]
  agentTemplates   AgentTemplate[]
  tasks            Task[]
  workflows        Workflow[]
  toolIntegrations ToolIntegration[]
  memoryEntries    MemoryEntry[]
  departments      Department[]
  approvalRequests ApprovalRequest[]
  governanceRules  GovernanceRule[]
  notifications    Notification[]
  apiKeys          ApiKey[]
  metrics          TenantMetric[]

  // Phase 4 back-relations
  analyticsModels   AnalyticsModel[]
  analyticsFeatures AnalyticsFeature[]
  crmConnectors     CrmConnector[]
  tenantLimit       TenantLimit?
  oauthTokens       OAuthToken[]
  invoices          Invoice[]
  expenses          Expense[]
  billingEvents     BillingEvent[]
  quotaUsages       QuotaUsage[]

  // Phase 5 back-relations - Routines
  routines    Routine[]
  routineRuns RoutineRun[]

  // Phase 5 back-relations - Costs
  costRecords   CostRecord[]
  budgetPolicies BudgetPolicy[]

  // Phase 5 back-relations - Goals & Projects
  goals    Goal[]
  projects Project[]

  // Workspace provisioning (optional — created when admin selects storage integration in wizard)
  provisioningConfig ProvisioningConfig?

  // Phase 7 back-relations - Agent versions
  agentVersions AgentVersion[]

  // Phase 2.1 back-relations - Evaluation runs
  evaluationRuns EvaluationRun[]

  // Phase 2.4 back-relations - Knowledge spaces
  knowledgeSpaces KnowledgeSpace[]

  // Phase 4.1 back-relations - SSO
  ssoConfig SsoConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenants")
}

// ─── User ──────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(USER)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  lastLoginAt  DateTime?
  metadata     Json      @default("{}")

  // Tenant relation — null for SUPER_ADMIN / PLATFORM_ADMIN
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  sessions           Session[]
  auditLogs          AuditLog[]
  refreshTokens      RefreshToken[]
  agents             Agent[]
  tasksCreated       Task[]            @relation("TaskCreator")
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequests")
  approvalsReviewed  ApprovalRequest[] @relation("ApprovalReviews")
  notifications      Notification[]
  apiKeys            ApiKey[]

  // Phase 5 back-relations - Routines
  routines    Routine[]
  routineRuns RoutineRun[]

  // Phase 5 back-relations - Goals
  goals Goal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ─── Session ───────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String?
  ipAddress String?
  userAgent String?
  isActive  Boolean  @default(true)
  expiresAt DateTime

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@map("sessions")
}

// ─── Refresh Token ─────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  isRevoked Boolean  @default(false)
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── Audit Log ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String  @id @default(uuid())
  actor      String // userId or "system"
  action     String // e.g. "auth.login", "agent.create"
  resource   String? // resource type
  resourceId String? // resource id
  tenantId   String?
  ipAddress  String?
  userAgent  String?
  result     String  @default("success") // success | failure
  details    Json    @default("{}")

  user   User?   @relation(fields: [actor], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([actor])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 2 Models
// ═══════════════════════════════════════════════════════════════════════════

// ─── Agent Template ───────────────────────────────────────────────────────

model AgentTemplate {
  id           String    @id @default(uuid())
  name         String
  description  String?   @db.Text
  type         AgentType @default(FUNCTIONAL)
  model        String    @default("gpt-4o-mini")
  systemPrompt String?   @db.Text
  instructions String?   @db.Text
  permissions  Json      @default("[]")
  config       Json      @default("{}")
  isPublic     Boolean   @default(false) // platform-wide template
  version      String    @default("1.0.0")

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Phase 6: Link to tier agent pools
  tierAgentPools TierAgentPool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([type])
  @@map("agent_templates")
}

// ─── Agent ────────────────────────────────────────────────────────────────

model Agent {
  id           String      @id @default(uuid())
  name         String
  description  String?
  type         AgentType   @default(FUNCTIONAL)
  status       AgentStatus @default(IDLE)
  model        String      @default("gpt-4o-mini") // LLM model ID
  systemPrompt String?     @db.Text
  instructions String?     @db.Text
  budgetPerDay Decimal?    @db.Decimal(10, 4)
  totalSpend   Decimal     @default(0) @db.Decimal(10, 4)
  permissions  Json        @default("[]") // array of allowed actions
  config       Json        @default("{}")
  metadata     Json        @default("{}")
  isActive     Boolean     @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  // Phase 6: Agents are selected from tier pool, not created freely
  tierAgentPoolId String?
  tierAgentPool   TierAgentPool? @relation(fields: [tierAgentPoolId], references: [id])

  // Template info stored for reference (template may change, agent keeps snapshot)
  templateId      String?
  templateVersion String?

  // Whether this agent slot is active for this tenant
  // Tenant can toggle selected agents within their tier allocation
  isSelected      Boolean @default(true)

  // Phase 2.1 — staging / deployment mode
  deploymentMode  DeploymentMode @default(PRODUCTION)
  stagingParentId String?
  stagingParent   Agent?  @relation("StagingCopies", fields: [stagingParentId], references: [id])
  stagingCopies   Agent[] @relation("StagingCopies")

  // Phase 2.3 — supervisor / worker hierarchy
  supervisorId String?
  supervisor   Agent?  @relation("WorkerAgents", fields: [supervisorId], references: [id])
  workers      Agent[] @relation("WorkerAgents")

  departmentId String?
  department   Department? @relation("DepartmentAgents", fields: [departmentId], references: [id])

  tasks          Task[]
  memoryEntries  MemoryEntry[]
  executionLogs  ExecutionLog[]
  expenses       Expense[]     @relation("AgentExpenses")
  quotaUsages    QuotaUsage[]  @relation("AgentQuotaUsage")

  // Phase 5 back-relations - Costs
  costRecords    CostRecord[]
  budgetPolicies BudgetPolicy[]

  // Phase 5 back-relations - Routines
  routineRuns RoutineRun[]

  // Phase 5 back-relations - Goals
  goals Goal[]

  // Phase 7 back-relations - Version history
  versions AgentVersion[]

  // Phase 2.1 back-relations - Evaluation runs
  evaluationRuns EvaluationRun[]

  // Phase 2.4 back-relations - Knowledge access
  knowledgeAccess AgentKnowledgeAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([departmentId])
  @@index([tierAgentPoolId])
  @@index([stagingParentId])
  @@index([supervisorId])
  @@map("agents")
}

// ─── Agent Version (Phase 7: Version Control + Rollback) ──────────────────

model AgentVersion {
  id            String  @id @default(uuid())
  agentId       String
  agent         Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versionNumber Int
  label         String?
  configSnapshot Json   // full config snapshot: name, model, systemPrompt, instructions, permissions, config
  changedBy     String  // userId or "system"
  changeNote    String? @db.Text
  isActive      Boolean @default(false) // true = currently deployed version

  createdAt DateTime @default(now())

  @@unique([agentId, versionNumber])
  @@index([agentId])
  @@index([tenantId])
  @@map("agent_versions")
}

// ─── Task ─────────────────────────────────────────────────────────────────

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  input       Json         @default("{}")
  output      Json?
  error       String?      @db.Text
  retryCount  Int          @default(0)
  maxRetries  Int          @default(3)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])

  workflowId String?
  workflow   Workflow? @relation(fields: [workflowId], references: [id])

  createdById String?
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id])

  executionLogs ExecutionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([agentId])
  @@index([workflowId])
  @@index([status])
  @@index([priority])
  @@map("tasks")
}

// ─── Workflow ─────────────────────────────────────────────────────────────

model Workflow {
  id          String         @id @default(uuid())
  name        String
  description String?        @db.Text
  status      WorkflowStatus @default(DRAFT)
  definition  Json           @default("{}") // DAG / step definitions
  config      Json           @default("{}")
  isTemplate  Boolean        @default(false)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("workflows")
}

// ─── Memory Entry ─────────────────────────────────────────────────────────

model MemoryEntry {
  id         String     @id @default(uuid())
  type       MemoryType @default(SHORT_TERM)
  content    String     @db.Text
  summary    String?    @db.Text
  embedding  String?    @db.Text // JSON-serialised float[] (legacy / fallback)
  // pgvector native column — populated when ENABLE_VECTOR_SEARCH=true
  embeddingVector Unsupported("vector(1536)")?
  importance Float      @default(0.5)
  expiresAt  DateTime?
  metadata   Json       @default("{}")

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([tenantId])
  @@index([type])
  @@map("memory_entries")
}

// ─── Tool Integration ─────────────────────────────────────────────────────

model ToolIntegration {
  id          String       @id @default(uuid())
  name        String
  description String?
  category    ToolCategory @default(CUSTOM)
  config      Json         @default("{}") // endpoint, auth, schema
  isActive    Boolean      @default(true)
  isBuiltIn   Boolean      @default(false)

  tenantId String? // null = platform-wide built-in
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  executionLogs ExecutionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([category])
  @@map("tool_integrations")
}

// ─── Execution Log ────────────────────────────────────────────────────────

model ExecutionLog {
  id      String  @id @default(uuid())
  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  toolId String?
  tool   ToolIntegration? @relation(fields: [toolId], references: [id])

  step            String // e.g. "plan", "execute", "evaluate"
  input           Json    @default("{}")
  output          Json?
  tokensUsed      Int     @default(0)
  costUsd         Decimal @default(0) @db.Decimal(10, 6)
  durationMs      Int     @default(0)
  success         Boolean @default(true)
  error           String? @db.Text
  evaluationScore Float? // 0–1 quality score from AgentEvaluator
  reflection      String? @db.Text // evaluator notes

  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([taskId])
  @@index([createdAt])
  @@map("execution_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 3 Models
// ═══════════════════════════════════════════════════════════════════════════

// ─── Department ───────────────────────────────────────────────────────────

model Department {
  id          String           @id @default(uuid())
  name        String
  description String?
  status      DepartmentStatus @default(ACTIVE)
  headAgentId String?
  parentId    String?
  metadata    Json             @default("{}")

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  parent      Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[]    @relation("DepartmentHierarchy")
  agents      Agent[]         @relation("DepartmentAgents")

  // Phase 5 back-relations - Costs
  costRecords    CostRecord[]
  budgetPolicies BudgetPolicy[]

  // Phase 5 back-relations - Goals & Projects
  goals    Goal[]
  projects Project[]

  // Phase 2.4 back-relations - Knowledge spaces
  knowledgeSpaces KnowledgeSpace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([parentId])
  @@map("departments")
}

// ─── Department Template ──────────────────────────────────────────────────
// Platform-wide blueprint (SuperAdmin managed). Tenants deploy from these.

model DepartmentTemplate {
  id          String  @id @default(uuid())
  name        String // e.g. "Startup Org", "E-Commerce Pack"
  slug        String  @unique
  description String? @db.Text
  // JSON array: [{ name, description?, type?, parentSlug? }]
  // type: "EXECUTIVE" | "CORE" | "FUNCTIONAL"
  structure   Json    @default("[]")
  isPublic    Boolean @default(true)
  category    String  @default("general") // "startup" | "enterprise" | "ecommerce" | etc.
  tags        Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublic])
  @@index([category])
  @@map("department_templates")
}

// ─── Governance Rule ──────────────────────────────────────────────────────

model GovernanceRule {
  id           String               @id @default(uuid())
  name         String
  description  String?
  trigger      String // e.g. "task.cost > 10", "agent.action == 'email'"
  actionType   GovernanceActionType @default(LOG_ONLY)
  actionConfig Json                 @default("{}")
  isActive     Boolean              @default(true)
  priority     Int                  @default(0)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([isActive])
  @@map("governance_rules")
}

// ─── Approval Request ─────────────────────────────────────────────────────

model ApprovalRequest {
  id              String           @id @default(uuid())
  title           String
  description     String?          @db.Text
  resourceType    String // "task", "agent_action", "workflow", "budget"
  resourceId      String?
  payload         Json             @default("{}")
  status          ApprovalStatus   @default(PENDING)
  priority        ApprovalPriority @default(MEDIUM)
  requiredRole    String? // role required to approve
  expiresAt       DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?          @db.Text
  metadata        Json             @default("{}")

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  requestedById String?
  requestedBy   User?   @relation("ApprovalRequests", fields: [requestedById], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("ApprovalReviews", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([requestedById])
  @@map("approval_requests")
}

// ─── Notification ─────────────────────────────────────────────────────────

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType @default(INFO)
  title   String
  message String           @db.Text
  isRead  Boolean          @default(false)
  payload Json             @default("{}")

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ─── API Key ──────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique
  prefix     String // first 8 chars shown in UI
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  scopes     Json      @default("[]")

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

// ─── Tenant Metric ────────────────────────────────────────────────────────

model TenantMetric {
  id         String     @id @default(uuid())
  type       MetricType @default(GAUGE)
  name       String // e.g. "agent.executions", "task.completions"
  value      Float
  labels     Json       @default("{}")
  recordedAt DateTime   @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([name])
  @@index([recordedAt])
  @@map("tenant_metrics")
}

// ─── Phase 4 Models: Analytics & Connectors ─────────────────────────────────

model AnalyticsModel {
  id          String  @id @default(uuid())
  name        String
  version     String
  description String? @db.Text
  metadata    Json    @default("{}")

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  analyticsFeatures AnalyticsFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("analytics_models")
}

model AnalyticsFeature {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  modelId String?
  model   AnalyticsModel? @relation(fields: [modelId], references: [id])

  features   Json
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([modelId])
  @@map("analytics_features")
}

model CrmConnector {
  id       String  @id @default(uuid())
  name     String
  provider String
  config   Json    @default("{}")
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("crm_connectors")
}

model TenantLimit {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  limits   Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_limits")
}

// ─── Phase 4.5: Quota Usage Tracking ─────────────────────────────────────

model QuotaUsage {
  id       String    @id @default(uuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId  String?
  agent    Agent?    @relation("AgentQuotaUsage", fields: [agentId], references: [id])
  quotaKey String // e.g. "agent_executions", "api_calls_per_minute", "model_scoring"
  used     Int       @default(0)
  limit    Int       @default(0)
  resetAt  DateTime? // null = never resets (lifetime quota)
  period   String    @default("daily") // hourly | daily | monthly | lifetime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, agentId, quotaKey, period])
  @@index([tenantId])
  @@index([quotaKey])
  @@map("quota_usage")
}

// ─── Phase 4.3: OAuth Token Store ─────────────────────────────────────────

model OAuthToken {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider     String // e.g. "salesforce", "hubspot"
  accessToken  String    @db.Text // encrypted at application layer
  refreshToken String?   @db.Text // encrypted
  expiresAt    DateTime?
  scopes       Json      @default("[]")
  metadata     Json      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("oauth_tokens")
}

// ─── Phase 4.4: Financial Module ──────────────────────────────────────────

model Invoice {
  id        String        @id @default(uuid())
  number    String        @unique // e.g. "INV-2026-001"
  status    InvoiceStatus @default(DRAFT)
  currency  String        @default("USD")
  subtotal  Decimal       @db.Decimal(14, 4)
  taxAmount Decimal       @default(0) @db.Decimal(14, 4)
  total     Decimal       @db.Decimal(14, 4)
  lineItems Json          @default("[]") // [{ description, qty, unitPrice, amount }]
  issuedAt  DateTime?
  dueAt     DateTime?
  paidAt    DateTime?
  notes     String?       @db.Text
  metadata  Json          @default("{}")

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  expenses      Expense[]
  billingEvents BillingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("invoices")
}

model Expense {
  id          String          @id @default(uuid())
  category    ExpenseCategory @default(CUSTOM)
  description String
  amountUsd   Decimal         @db.Decimal(14, 6)
  currency    String          @default("USD")
  metadata    Json            @default("{}")

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  agentId String?
  agent   Agent?  @relation("AgentExpenses", fields: [agentId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([agentId])
  @@index([invoiceId])
  @@map("expenses")
}

model BillingEvent {
  id          String           @id @default(uuid())
  type        BillingEventType
  payload     Json             @default("{}")
  processedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([type])
  @@map("billing_events")
}

// ═══════════════════════════════════════════════════════════════════════════
// Routines Module (Paperclip Integration)
// ═══════════════════════════════════════════════════════════════════════════

enum RoutineStatus {
  DRAFT
  ACTIVE
  PAUSED
  DISABLED
}

enum RoutineTriggerType {
  SCHEDULE // Cron-based scheduling
  WEBHOOK // HTTP webhook trigger
  EVENT // Event-based trigger
  MANUAL // Manual trigger only
}

enum RoutineRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Routine {
  id          String        @id @default(uuid())
  name        String
  description String?       @db.Text
  status      RoutineStatus @default(DRAFT)

  // LangGraph workflow definition
  graphDefinition Json @default("{}") // Nodes, edges, conditional logic

  // Configuration
  config   Json @default("{}") // maxIterations, timeout, retryPolicy
  metadata Json @default("{}")

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  triggers RoutineTrigger[]
  runs     RoutineRun[]

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("routines")
}

model RoutineTrigger {
  id     String             @id @default(uuid())
  type   RoutineTriggerType
  name   String? // Optional trigger name
  config Json               @default("{}") // cron expression, webhook secret, event filter

  // Webhook specifics
  webhookPath   String? @unique // /webhooks/routines/:id/:secret
  webhookSecret String? // For webhook signature validation

  isActive Boolean @default(true)

  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  lastFiredAt DateTime?
  nextFireAt  DateTime? // For schedule triggers

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([routineId])
  @@index([type])
  @@index([webhookPath])
  @@map("routine_triggers")
}

model RoutineRun {
  id String @id @default(uuid())

  // Execution state (LangGraph checkpoint)
  state    Json? // Serialized graph state for resumption
  threadId String // LangGraph thread identifier

  // Execution results
  status RoutineRunStatus @default(PENDING)
  input  Json             @default("{}")
  output Json?
  error  String?          @db.Text

  // Metrics
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  // Trigger info
  triggerType RoutineTriggerType?
  triggerId   String?

  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Agent execution
  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([routineId])
  @@index([tenantId])
  @@index([status])
  @@index([triggerType])
  @@map("routine_runs")
}

// ═══════════════════════════════════════════════════════════════════════════
// Cost Tracking Module (Paperclip Integration)
// ═══════════════════════════════════════════════════════════════════════════

enum BudgetPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum BudgetScope {
  TENANT
  DEPARTMENT
  AGENT
  MODEL
}

enum BudgetAction {
  ALERT
  BLOCK
  DEGRADE
}

enum BudgetIncidentStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model CostRecord {
  id     String @id @default(uuid())

  // Cost attribution
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  agentId     String?
  agent       Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // LLM Cost details
  provider     String  // OPENAI, ANTHROPIC, MINIMAX, DEEPSEEK
  model        String
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  costCents    Decimal @db.Decimal(10, 4)

  // Time window for aggregation
  windowStart DateTime
  windowEnd   DateTime

  // Optional: Link to LangSmith run for traceability
  langSmithRunId String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([agentId])
  @@index([departmentId])
  @@index([provider])
  @@index([model])
  @@index([windowStart, windowEnd])
  @@map("cost_records")
}

model BudgetPolicy {
  id     String @id @default(uuid())

  // Policy details
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name            String
  limitCents      Decimal @db.Decimal(12, 2)
  period          BudgetPeriod @default(MONTHLY)
  scope           BudgetScope @default(TENANT)

  // Alert configuration
  alertThresholds Int[]    @default([50, 75, 90]) // percentages at which to alert
  action          BudgetAction @default(ALERT) // What to do when exceeded

  enabled       Boolean @default(true)
  currentSpendCents Decimal @default(0) @db.Decimal(12, 2)
  resetAt       DateTime // When the budget period resets

  // Scope relations - separate fields for different scope types
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  agentId String?
  agent   Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  // Optional: scope by model (stored as string for flexibility)
  modelPattern String?

  incidents    BudgetIncident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([scope])
  @@index([departmentId])
  @@index([agentId])
  @@index([enabled])
  @@index([resetAt])
  @@map("budget_policies")
}

// ─── Phase D: Goals & Projects ───────────────────────────────────────────────

enum GoalLevel {
  COMPANY
  DEPARTMENT
  TEAM
  INDIVIDUAL
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

model Goal {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?    @db.Text

  level       GoalLevel  @default(INDIVIDUAL)
  status      GoalStatus @default(ACTIVE)
  progress    Int        @default(0) // 0-100

  // Hierarchy
  parentId    String?
  parent      Goal?      @relation("GoalHierarchy", fields: [parentId], references: [id])
  children    Goal[]     @relation("GoalHierarchy")

  // Ownership
  ownerAgentId String?
  ownerAgent   Agent?    @relation(fields: [ownerAgentId], references: [id], onDelete: SetNull)

  ownerUserId  String?
  ownerUser    User?     @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  // Linking
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Dates
  targetDate   DateTime?
  completedAt  DateTime?

  // Metrics
  metrics Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([parentId])
  @@index([status])
  @@index([ownerAgentId])
  @@index([ownerUserId])
  @@map("goals")
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Project {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String
  description  String?       @db.Text
  status       ProjectStatus @default(ACTIVE)

  // Linking
  goalIds      String[]      @default([]) // Related goals
  departmentId  String?
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Dates
  targetDate   DateTime?

  // Metadata
  metadata     Json          @default("{}")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([departmentId])
  @@map("projects")
}

model BudgetIncident {
  id     String @id @default(uuid())

  budgetPolicyId String
  budgetPolicy   BudgetPolicy @relation(fields: [budgetPolicyId], references: [id], onDelete: Cascade)

  threshold       Int // percentage that triggered this incident
  totalCents      Decimal @db.Decimal(12, 2) // spend at time of incident
  status          BudgetIncidentStatus @default(ACTIVE)

  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([budgetPolicyId])
  @@index([status])
  @@map("budget_incidents")
}

// ═══════════════════════════════════════════════════════════════════════════
// Workspace Provisioning
// ═══════════════════════════════════════════════════════════════════════════

// ─── ProvisioningConfig ───────────────────────────────────────────────────
// One config per tenant — stores intent captured during wizard + OAuth tokens
// after admin connects their Google Workspace / Microsoft 365 account.

model ProvisioningConfig {
  id                 String                   @id @default(uuid())
  tenantId           String                   @unique
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider           ProvisioningProvider
  emailDomain        String
  emailPattern       EmailPattern             @default(FIRST_DOT_LAST)
  folderStructure    FolderStructure          @default(BY_DEPARTMENT)
  status             ProvisioningConfigStatus @default(PENDING_CONNECT)

  // TODO(security): encrypt with AES-256-GCM using ENCRYPTION_KEY env var before going to production
  oauthAccessToken   String?
  oauthRefreshToken  String?
  oauthExpiresAt     DateTime?
  externalIdentifier String?

  jobs      ProvisioningJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("provisioning_configs")
}

// ─── ProvisioningJob ──────────────────────────────────────────────────────
// One job per invited user — tracks the provisioning of their corporate
// email address and cloud storage folder.

model ProvisioningJob {
  id                  String                @id @default(uuid())
  configId            String
  config              ProvisioningConfig    @relation(fields: [configId], references: [id], onDelete: Cascade)
  inviteeEmail        String
  inviteeFirstName    String
  inviteeLastName     String
  departmentName      String?
  provisionedEmail    String?
  provisionedFolderId String?
  status              ProvisioningJobStatus @default(PENDING)
  errorMessage        String?
  provisionedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([configId])
  @@map("provisioning_jobs")
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 2.1 — Agent Staging + Evaluation Runs
// ═══════════════════════════════════════════════════════════════════════════

/// A test run executed against a staging agent copy before promoting to production.
model EvaluationRun {
  id           String           @id @default(uuid())
  agentId      String
  agent        Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status       EvaluationStatus @default(PENDING)
  /// Array of { input, expectedOutput, … } test case objects
  testCases    Json             @default("[]")
  /// Array of { testCaseIndex, passed, actualOutput, latencyMs } results
  results      Json?
  /// Overall pass-rate 0–100
  scoreOverall Decimal?         @db.Decimal(5, 2)
  runBy        String
  notes        String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([tenantId])
  @@map("evaluation_runs")
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 2.4 — Knowledge Spaces
// ═══════════════════════════════════════════════════════════════════════════

/// A named collection of documents accessible to one or more agents.
model KnowledgeSpace {
  id           String      @id @default(uuid())
  name         String
  description  String?     @db.Text
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  documents KnowledgeDocument[]
  agents    AgentKnowledgeAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([departmentId])
  @@map("knowledge_spaces")
}

/// A single document (text chunk) stored in a knowledge space.
/// The embedding column requires the pgvector extension (enabled on Neon).
model KnowledgeDocument {
  id         String              @id @default(uuid())
  spaceId    String
  space      KnowledgeSpace      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  title      String
  content    String              @db.Text
  sourceType KnowledgeSourceType @default(MANUAL)
  sourceUrl  String?
  /// pgvector embedding — use @db.VectorType after installing prisma-pg-vector or raw SQL for now
  metadata   Json                @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@map("knowledge_documents")
}

/// Many-to-many: which agents can read which knowledge spaces.
model AgentKnowledgeAccess {
  id      String         @id @default(uuid())
  agentId String
  agent   Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  spaceId String
  space   KnowledgeSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([agentId, spaceId])
  @@index([agentId])
  @@index([spaceId])
  @@map("agent_knowledge_access")
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 4.1 — SSO Config scaffold
// ═══════════════════════════════════════════════════════════════════════════

/// Per-tenant SSO configuration. Supports SAML 2.0 and OIDC.
model SsoConfig {
  id         String      @id @default(uuid())
  tenantId   String      @unique
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider   SsoProvider
  /// SAML: IdP single sign-on URL
  entryPoint String?
  /// SAML: IdP entity ID
  issuer     String?
  /// SAML: X.509 certificate (PEM)
  cert       String?     @db.Text
  /// OIDC: client_id
  clientId   String?
  isEnabled  Boolean     @default(false)
  metadata   Json        @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sso_configs")
}
